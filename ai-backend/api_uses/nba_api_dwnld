import requests
import os
import time
from datetime import datetime

API_KEY  = os.environ["RAPIDAPI_KEY"]
SEASON   = "2024"
WIKI_DIR = "wiki"

HEADERS = {
    "x-rapidapi-key":  API_KEY,
    "x-rapidapi-host": "nba-api-free-data.p.rapidapi.com"
}

def get(endpoint, params={}):
    url = f"https://nba-api-free-data.p.rapidapi.com/{endpoint}"
    r = requests.get(url, headers=HEADERS, params=params)
    r.raise_for_status()
    return r.json()

def fetch_all_player_stats():
    print("🏀 Fetchujem statistike svih igrača...")
    all_players = []
    page = 1

    while True:
        print(f"  → Stranica {page}...")
        data = get("players/statistics", {"season": SEASON, "page": page})
        
        players = data.get("response", [])
        if not players:
            break  # nema više podataka
        
        all_players.extend(players)
        
        # Provjeri koliko ima ukupno stranica
        total_pages = data.get("paging", {}).get("total", 1)
        if page >= total_pages:
            break
        
        page += 1
        time.sleep(0.5)  # rate limit

    print(f"  Ukupno igrača: {len(all_players)}")
    save_player_stats_md(all_players)

def save_player_stats_md(players):
    os.makedirs(f"{WIKI_DIR}/players", exist_ok=True)
    
    # ── 1. Master tabela svih igrača ──
    lines = [
        f"# NBA Player Statistics — {SEASON}",
        f"_Osveženo: {datetime.now().strftime('%Y-%m-%d')}_\n",
        "| Igrač | Tim | Pos | MIN | PTS | REB | AST | STL | BLK | FG% | 3P% | FT% |",
        "|-------|-----|-----|-----|-----|-----|-----|-----|-----|-----|-----|-----|",
    ]

    for p in sorted(players, key=lambda x: float(x.get("points", {}).get("per_game", 0) or 0), reverse=True):
        name  = f"{p.get('firstname','')} {p.get('lastname','')}"
        team  = p.get("team", {}).get("nickname", "-")
        pos   = p.get("pos", "-")
        stats = p.get("statistics", [{}])[0] if p.get("statistics") else {}
        
        pts  = stats.get("points",   "-")
        reb  = stats.get("totReb",   "-")
        ast  = stats.get("assists",  "-")
        stl  = stats.get("steals",   "-")
        blk  = stats.get("blocks",   "-")
        min_ = stats.get("min",      "-")
        fgp  = stats.get("fgp",      "-")
        tpp  = stats.get("tpp",      "-")  # 3P%
        ftp  = stats.get("ftp",      "-")
        
        lines.append(f"| {name} | {team} | {pos} | {min_} | {pts} | {reb} | {ast} | {stl} | {blk} | {fgp} | {tpp} | {ftp} |")

    with open(f"{WIKI_DIR}/players/all_stats.md", "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
    print(f"  ✅ Sačuvan: wiki/players/all_stats.md")

    # ── 2. Individualni fajl po igraču (za LLM context) ──
    for p in players:
        first = p.get("firstname", "")
        last  = p.get("lastname",  "")
        if not first and not last:
            continue
        
        stats = p.get("statistics", [{}])[0] if p.get("statistics") else {}
        slug  = f"{first}_{last}".lower().replace(" ", "_").replace("'", "")
        team  = p.get("team", {}).get("name", "-")
        
        content = f"""# {first} {last}
**Tim:** {team}  
**Pozicija:** {p.get('pos', '-')}  
**Sezona:** {SEASON}

## Prosjeci po utakmici
- Poeni: {stats.get('points', '-')}
- Skokovi: {stats.get('totReb', '-')}
- Asistencije: {stats.get('assists', '-')}
- Ukradene lopte: {stats.get('steals', '-')}
- Blokade: {stats.get('blocks', '-')}
- Minuti: {stats.get('min', '-')}

## Efikasnost šutiranja
- FG%: {stats.get('fgp', '-')}
- 3P%: {stats.get('tpp', '-')}
- FT%: {stats.get('ftp', '-')}
"""
        with open(f"{WIKI_DIR}/players/{slug}.md", "w", encoding="utf-8") as f:
            f.write(content)

    print(f"  ✅ Individualni fajlovi: {len(players)} igrača")

if __name__ == "__main__":
    fetch_all_player_stats()